# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# ─── CRITICAL: PostgreSQL database ────────────────────────────────────────────
# On Render: go to Dashboard → New → PostgreSQL → create a free database
# Then copy the "Internal Database URL" and paste it here.
# Without this, SQLite is used and ALL USER DATA IS LOST on every deploy.
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Superuser auto-created on deploy ─────────────────────────────────────────
# Set these on Render under Environment → Add Environment Variable
# build.sh will create this account automatically on first deploy.
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# Database Configuration
DB_NAME=artx_platform
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration for Production
# Add your Render URL here — e.g. https://your-app-name.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-app-name.onrender.com

# Django allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,artx-website.onrender.com

