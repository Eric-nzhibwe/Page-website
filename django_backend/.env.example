# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# ─── Database (PostgreSQL on Render) ──────────────────────────────────────────
# Go to Render Dashboard → New → PostgreSQL → copy the Internal Database URL
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Superuser (auto-created on first deploy via build.sh) ────────────────────
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-app-name.onrender.com

# ─── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER controls which backend sends emails:
#
#   resend   -- HTTPS API, works on Render free tier. Get a free key at resend.com
#   smtp     -- Direct SMTP. Works locally, BLOCKED on Render free plan.
#   console  -- Prints to stdout only. Safe local dev default.
#
EMAIL_PROVIDER=console

# Resend (for production on Render free tier)
# 1. Sign up at https://resend.com
# 2. Verify your domain OR use the test address: onboarding@resend.dev
# 3. API Keys -> Create Key -> paste below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP credentials (only used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

DEFAULT_FROM_EMAIL=ARTX Platform <noreply@artxplatform.com>

# ─── Frontend URL (used in email CTA buttons) ──────────────────────────────────
# Local dev:   http://localhost:8000
# Production:  https://your-app-name.onrender.com
FRONTEND_BASE_URL=http://localhost:8000

# ─── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ─── PawaPay (African Mobile Money) ───────────────────────────────────────────
# https://dashboard.pawapay.cloud → API Keys
PAWAPAY_API_KEY=your_pawapay_jwt_here
PAWAPAY_API_URL=https://api.pawapay.cloud
PAWAPAY_WEBHOOK_SECRET=your_pawapay_webhook_secret_here

# ─── Paystack ──────────────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# ─── SMS ───────────────────────────────────────────────────────────────────────
# SMS_PROVIDER controls which backend sends messages:
#
#   twilio          Global coverage. Free trial at twilio.com.
#   africastalking  Cheaper rates for African numbers. Free sandbox at africastalking.com.
#   console         Prints to stdout only. Safe local dev default.
#
SMS_PROVIDER=console

# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (used when SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_SENDER_ID=ARTX

# ─── Groq / LLaMA 3 — FREE & very fast ────────────────────────────────────────
# Get a free key → https://console.groq.com/keys
# Install: pip install groq
GROQ_API_KEY=gsk_your_groq_key_here
