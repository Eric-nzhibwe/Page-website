# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.onrender.com

# ─── Database (PostgreSQL on Render) ──────────────────────────────────────────
# Go to Render Dashboard → New → PostgreSQL → copy the Internal Database URL
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Superuser (auto-created on first deploy via build.sh) ────────────────────
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-app-name.onrender.com

# ─── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER controls which backend sends emails:
#
#   resend   -- HTTPS API, works on Render free tier. Get a free key at resend.com
#   smtp     -- Direct SMTP. Works locally, BLOCKED on Render free plan.
#   console  -- Prints to stdout only. Safe local dev default.
#
EMAIL_PROVIDER=console

# Resend (for production on Render free tier)
# 1. Sign up at https://resend.com
# 2. Verify your domain OR use the test address: onboarding@resend.dev
# 3. API Keys -> Create Key -> paste below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP credentials (only used when EMAIL_PROVIDER=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

DEFAULT_FROM_EMAIL=PAGE Platform <noreply@pageplatform.com>

# ─── Frontend URL (used in email CTA buttons) ──────────────────────────────────
# Local dev:   http://localhost:8000
# Production:  https://your-app-name.onrender.com
FRONTEND_BASE_URL=http://localhost:8000

# ─── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ─── PawaPay (African Mobile Money) ───────────────────────────────────────────
# https://dashboard.pawapay.cloud → API Keys
PAWAPAY_API_KEY=your_pawapay_jwt_here
PAWAPAY_API_URL=https://api.pawapay.cloud
PAWAPAY_WEBHOOK_SECRET=your_pawapay_webhook_secret_here

# ─── Paystack ──────────────────────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# ─── SMS ───────────────────────────────────────────────────────────────────────
# SMS_PROVIDER controls which backend sends messages:
#
#   twilio          Global coverage. Free trial at twilio.com.
#   africastalking  Cheaper rates for African numbers. Free sandbox at africastalking.com.
#   console         Prints to stdout only. Safe local dev default.
#
SMS_PROVIDER=console

# Twilio (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Africa's Talking (used when SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_africastalking_api_key_here
AFRICASTALKING_SENDER_ID=PAGE

# ─── Groq / LLaMA 3 — FREE & very fast ────────────────────────────────────────
# Get a free key → https://console.groq.com/keys
# Install: pip install groq
GROQ_API_KEY=gsk_your_groq_key_here

# ─── Firebase / Firestore ──────────────────────────────────────────────────────
# Used as a gradual replacement for PostgreSQL, one collection at a time.
#
# Setup:
#   1. Go to https://console.firebase.google.com → create a project
#   2. Project Settings → Service Accounts → Generate new private key
#      (this downloads a JSON file)
#   3. Copy each field from the JSON into the vars below
#   4. FIREBASE_PRIVATE_KEY must include the full PEM block with \n line breaks
#
FIREBASE_PROJECT_ID=page-website
FIREBASE_PRIVATE_KEY_ID=FIREBASE_KEY_ID_REDACTED
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nFIREBASE_PRIVATE_KEY_REDACTED\njh86m7sgtTAK6D/ZcehHDRHBhpNA2qKg18AnsJRltN5SogxDpWKpgu2uUttzcXCz\nqgjKBIysUgnzf1t7ziS4p5NE/oVf0qu5AzF5KKRykhHc8vfeaHuaACuKv+7kaRFy\ndbjJ6Ts0M/jXVnudeU4LS+zrnGCOI4MBt54Y3iavO40N6w5YSHuSHYtXlcSzvWBs\now9wypeHQ1BGuiZQQpvGT0yT298Y0owO07tyUDlSMbhAI7c3Lg9a+m+I21WMcdrl\nTGyx+5mkA2SrSoCmsmHqp31aDAEk0iLi0dxlA4pnuAq5Abj/raxfGXWuz9e2jOBx\npJizrvexAgMBAAECggEAN8EvbWHHW/o8lzmyKmpC5iaHf/zZQS0DSf1bk8HhSEr2\nHIXqHGrKgEsuNX//WmG3H91kLEB7+HTjerfET2bzIYgT8HSJqUcO9lc9nLtG78aG\nN6g9aDmttvmKGq60xXxEQpaIE+FeIBirraEt0EzfVGh1UlwlqswuBtSa9G1dTm5n\nVr3LZ/lU6IoPsOQQ4tPpKqJROxyRKNWmgxeoxR75GsDmE9OAOuUiMI+Lbq2815h/\nOkw6/083pt7YBNwGfyvY/9fo8DriEuCgzASXNO2gNqVK+6QWKrnka6XXV5+LDoiH\n0FCSXrxCSGODLouSWnIGvH/+RKPK1IHDO5/cFkG/GwKBgQDqJF11Ou7mqUNmOP+l\n7g9czPTKMLR8LRciaq1LKMZoxsdrNcgHy9tI9sukLvEVG4EIp/dnL9tTYj4GfZde\ngakrSj+a30+3o1cXoReVnnK5NZW9FbWzXZTFwUMmXXcFFBoBFV+MfDqgcjVX1dbj\njf8OF5Epa2rtNOCRc1MUlfnEgwKBgQDCO+xQT9bhwd0wuIhjeAjkJEX8clAVFkTF\nhndu4Mv9yriPS+ikBdiQd3xKKtdKsRMsIakEFKCCnYurlx9xpIHO7eZzgWCfsxd3\n89rjd14sBSO1xhiCmSNLzVyC4PC6y+DO5Nv6bMTkv5owrKGNoqpqWOXzzNSu9cn1\nbPbRX94kuwKBgQDLmz/iF5Nz5bEEjYBSLIgTbO9Ze60XZqZ9eUKk3xpaNrFnW2dM\n0EsqUeKYLXHbpwU4H8gWZRlWk1HYlxIwTpRrXq+c36AU0ueDVsSJiTW+NQi3Ws+c\n4D3lEcBw9knvkqFiW9Gw+r6Ik4grj3rEetBW0suatxxOlfLKyPxwJFMEPQKBgFx3\nKG2nRHWe08zg3FT2DM2HEyY1yTfwrPaXp/3J2HLOcgQNsAd9nPZRW4L3WBx/pc/p\nikueAjeMBrS+McLo/L7k9ENigPwlxvNczIRjDBrKq5BaaMqrWmk4r2TC7vcOHcyA\nmNRjuWvoZt/rHtGNcbFE9tuUVF+iNO24XNuZ1ugHAoGAad+GBdKWRDrZe1Lz0VRH\nyCRUoNX6s5RQaAYUN4ZrNr4sPyqME8/LXuaIscKmj7SyMRBOkTelxjLFWrubNrsb\nqeBcEneF/TuCvRE+JVnP2/zQYKbg50IBFIbJ1tyKtF6oqaeTQTR5UuaWs4SytYNh\npC+r37A3CfzZbOTB7srOXoQ=\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=FIREBASE_CLIENT_ID_REDACTED
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40page-website.iam.gserviceaccount.com

# ── Firebase Web SDK (public — used by the frontend JS SDK for Firebase Auth) ─
# Firebase Console → Project Settings → Your apps → web app (add one if none)
# → SDK setup and configuration → Config
FIREBASE_WEB_API_KEY=GCP_API_KEY_REDACTED
FIREBASE_AUTH_DOMAIN=page-website.firebaseapp.com
FIREBASE_STORAGE_BUCKET=page-website.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=FIREBASE_SENDER_ID_REDACTED
FIREBASE_APP_ID=1:FIREBASE_SENDER_ID_REDACTED:web:FIREBASE_APP_ID_REDACTED

# ─── Firestore collection feature flags ───────────────────────────────────────
# Flip a flag to True AFTER running the matching migration command and verifying
# the data in Firebase Console. All default to False (PostgreSQL used).
#
#   python manage.py migrate_notifications_to_firestore   → then set FS_NOTIFICATIONS=True
#
FS_NOTIFICATIONS=False
FS_ACTIVITIES=False
FS_CHATBOT=False
FS_CHALLENGES=False
FS_SUBMISSIONS=False
FS_SOCIAL=False
FS_ALLIANCES=False
FS_USERS=False
FS_PAYMENTS=False
